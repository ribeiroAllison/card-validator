# --- Azure DevOps ---
# Deixe em branco para rodar em modo demo, com os cards de exemplo em samples/cards.json
AZDO_ORG=            # ex.: peers-solutions  (de https://dev.azure.com/peers-solutions)
AZDO_PROJECT=        # ex.: Projeto-Interno
AZDO_PAT=            # Personal Access Token com escopo "Work Items: Read & write"

# --- IA ---
# claude | gemini | mock. Em branco: usa a primeira chave configurada (Claude, depois Gemini); sem chave, mock
AI_PROVIDER=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini (Google AI Studio). Free tier: o Google pode usar os dados -> só cards de teste
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- App ---
MIN_SCORE=70         # nota mínima (0-100) para liberar a geração de cenários
PORT=3001
APP_PASSWORD=        # se preenchida, o app pede senha (qualquer usuário). Recomendado quando publicado
